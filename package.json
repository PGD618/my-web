{
  "name": "my-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "git submodule update --remote --merge content",
    "dev": "concurrently -n next,velite,sync -c cyan,magenta,green \"next dev\" \"velite --watch\" \"node scripts/auto-pull.mjs\"",
    "prebuild": "git config --global url.\"https://${GITHUB_TOKEN:-}@github.com/\".insteadOf \"https://github.com/\" 2>/dev/null; git submodule update --remote --merge content 2>/dev/null; echo done",
    "build": "next build",
    "velite": "velite",
    "start": "next start",
    "lint": "eslint",
    "sync:obsidian": "git submodule update --remote --merge content"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@shikijs/rehype": "^4.0.2",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "fumadocs-core": "^16.7.7",
    "fumadocs-ui": "^16.7.7",
    "fuse.js": "^7.3.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-icons": "^5.6.0",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "^0.3.1"
  }
}
